# 应用配置
NODE_ENV=development
PORT=3000
APP_NAME=Magento-CJ-Middleware
APP_VERSION=1.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=magento_cj_middleware
DB_USER=root
DB_PASSWORD=your_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Magento配置
MAGENTO_BASE_URL=http://localhost/magento2
MAGENTO_API_TOKEN=your_magento_api_token
MAGENTO_API_USER=admin
MAGENTO_API_PASSWORD=your_admin_password

# CJ Dropshipping配置
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_API_EMAIL=your_cj_email
CJ_API_PASSWORD=your_cj_api_key

# JWT配置
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 队列配置
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1

# 重试配置
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5000

# 同步配置
SYNC_INTERVAL_MINUTES=30
BATCH_SIZE=100 