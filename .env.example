# 应用基础配置
APP_NAME=Magento-CJ-Middleware
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=3000

# 安全配置
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_NAME=magento_cj_middleware
DB_USER=root
DB_PASSWORD=your-database-password-here
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100

# 队列配置
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1
QUEUE_REDIS_PASSWORD=

# Magento配置
MAGENTO_BASE_URL=https://your-magento-domain.com
MAGENTO_CONSUMER_KEY=your-magento-consumer-key
MAGENTO_CONSUMER_SECRET=your-magento-consumer-secret
MAGENTO_ACCESS_TOKEN=your-magento-access-token
MAGENTO_ACCESS_TOKEN_SECRET=your-magento-access-token-secret
MAGENTO_TIMEOUT=30
MAGENTO_MAX_RETRIES=3

# CJ Dropshipping配置
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_API_EMAIL=your-cj-email@example.com
CJ_API_KEY=your-cj-api-key
CJ_TIMEOUT=30
CJ_MAX_RETRIES=3

# 同步配置
SYNC_INTERVAL_MINUTES=30
BATCH_SIZE=100
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5000

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10
LOG_BACKUP_COUNT=5

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090

# SSL配置
VERIFY_SSL=false
SSL_CERT_PATH=

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS配置
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://mcj.yokileopard.top"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "mcj.yokileopard.top"] 