# =============================================================================
# Magento-CJ Middleware — 通用环境变量模板
# =============================================================================
# 用法:
#   沙箱: cp deploy/env/sandbox.env .env
#   正式: cp deploy/env/production.env .env
# =============================================================================

# ---- 环境标识 ----
APP_ENV=sandbox              # sandbox | production
DEBUG=true                   # sandbox=true, production=false
APP_NAME=Magento-CJ-Middleware
PORT=3000

# ---- 密钥（生产环境务必更换） ----
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=24h
API_KEY=change-me-to-a-random-string

# ---- 中间件数据库（MySQL） ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=magento_cj
DB_USER=magento_user
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- 缓存（Redis） ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100

# ---- 任务队列 ----
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1
QUEUE_REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Magento API 配置 ----
# 沙箱: 指向 localhost 或 host.docker.internal
# 正式: 指向 https://shop.yokileopard.top
MAGENTO_BASE_URL=http://host.docker.internal:8088
MAGENTO_PUBLIC_URL=https://shop.yokileopard.top
MAGENTO_STORE_CODE=default
MAGENTO_TIMEOUT=30
MAGENTO_MAX_RETRIES=3

# Magento OAuth 凭据
MAGENTO_CONSUMER_KEY=
MAGENTO_CONSUMER_SECRET=
MAGENTO_ACCESS_TOKEN=
MAGENTO_ACCESS_TOKEN_SECRET=

# Magento API 凭据（替代方案）
MAGENTO_API_TOKEN=
MAGENTO_API_USER=admin
MAGENTO_API_PASSWORD=change-me
MAGENTO_ADMIN_USERNAME=admin
MAGENTO_ADMIN_PASSWORD=change-me

# Magento 数据库直连（属性映射器用）
MAGENTO_DB_HOST=host.docker.internal
MAGENTO_DB_PORT=33061
MAGENTO_DB_NAME=magento
MAGENTO_DB_USER=magento
MAGENTO_DB_PASSWORD=magento

# ---- CJ Dropshipping 配置 ----
# 沙箱: CJ 沙箱账号（如可用）
# 正式: 真实 CJ 账号
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_API_EMAIL=your-cj-email@example.com
CJ_API_KEY=your-cj-api-key
CJ_API_PASSWORD=your-cj-api-password
CJ_TIMEOUT=30
CJ_MAX_RETRIES=3

# ---- CORS / 跨域 ----
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://mcj.yokileopard.top"]
ALLOWED_HOSTS=["localhost","127.0.0.1","mcj.yokileopard.top"]

# ---- 同步配置 ----
SYNC_INTERVAL_MINUTES=30
BATCH_SIZE=100
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5000

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10
LOG_BACKUP_COUNT=5

# ---- 监控 ----
ENABLE_METRICS=true
METRICS_PORT=9090
VERIFY_SSL=false
