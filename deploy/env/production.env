# =============================================================================
# Magento-CJ Middleware — 正式环境（阿里云 ECS Docker）
# =============================================================================

# ---- 环境标识 ----
APP_ENV=production
DEBUG=false
APP_NAME=Magento-CJ-Middleware
PORT=3000

# ---- 密钥（ECS 上务必更换为新的随机密钥） ----
SECRET_KEY=kyTSXQZIQqYmRXPhOq0BMlk8jwNqKi1rTXMgfVfAkw4=
JWT_SECRET=f8e1a0b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0
JWT_EXPIRES_IN=24h
API_KEY=change-me-on-ecs

# ---- 中间件数据库（正式独立 MySQL，后期可切 RDS） ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=magento_cj
DB_USER=magento_user
DB_PASSWORD=change-me-on-ecs
DB_CHARSET=utf8mb4
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ---- 缓存 ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=200

# ---- 任务队列 ----
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1
QUEUE_REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Magento API ----
MAGENTO_BASE_URL=https://shop.yokileopard.com
MAGENTO_PUBLIC_URL=https://shop.yokileopard.com
MAGENTO_CONSUMER_KEY=n335uxpvcnl5igkqskijpx0lxv64y6n1
MAGENTO_CONSUMER_SECRET=efsqtgqb76xh72l0itz48exmr2kyyg6d
MAGENTO_ACCESS_TOKEN=o8yw0zym3qeej4zlxtj33b5w2pigeqjr
MAGENTO_ACCESS_TOKEN_SECRET=adslhe0umx57ax04o9s2hpklx2y5q072
MAGENTO_API_TOKEN=change-me-on-ecs
MAGENTO_API_USER=admin
MAGENTO_API_PASSWORD=change-me-on-ecs
MAGENTO_ADMIN_USERNAME=admin
MAGENTO_ADMIN_PASSWORD=change-me-on-ecs
MAGENTO_STORE_CODE=default
MAGENTO_TIMEOUT=30
MAGENTO_MAX_RETRIES=3

# Magento 数据库直连（同一 Docker 网络内）
MAGENTO_DB_HOST=host.docker.internal
MAGENTO_DB_PORT=3306
MAGENTO_DB_NAME=magento
MAGENTO_DB_USER=magento
MAGENTO_DB_PASSWORD=magento

# ---- CJ Dropshipping（正式模式） ----
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_API_EMAIL=liuqy93@hotmail.com
CJ_API_KEY=CJ4438498@api@82c1cb1c7d0f41dd809696fa18251aa7
CJ_API_PASSWORD=CJ4438498@api@82c1cb1c7d0f41dd809696fa18251aa7
CJ_TIMEOUT=30
CJ_MAX_RETRIES=3

# ---- CORS ----
ALLOWED_ORIGINS=["https://shop.yokileopard.com","https://mcj.yokileopard.com","https://shop.yokileopard.top","https://mcj.yokileopard.top"]
ALLOWED_HOSTS=["shop.yokileopard.com","mcj.yokileopard.com","shop.yokileopard.top","mcj.yokileopard.top","localhost"]

# ---- 同步 ----
SYNC_INTERVAL_MINUTES=30
BATCH_SIZE=200
MAX_RETRY_ATTEMPTS=5
RETRY_DELAY=5000

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=20
LOG_BACKUP_COUNT=10

# ---- 监控 ----
ENABLE_METRICS=true
METRICS_PORT=9090
VERIFY_SSL=true
